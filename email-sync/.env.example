# Gmail OAuth (Desktop app credential type) — from Google Cloud Console
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Same Neon database the Express server uses
DATABASE_URL=

# Encrypts Gmail refresh tokens at rest in the gmail_connections table.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Different from the server's JWT_SECRET on purpose.
TOKEN_ENCRYPTION_KEY=

# Only needed for the one-time `npm run get-token` setup step — the
# job-tracker login this Gmail connection should be attached to.
TARGET_USER_EMAIL=

# Optional — free-tier fallback for emails the rules can't classify.
# Leave blank to skip the fallback (those emails are just logged as
# "NEEDS REVIEW" instead).
GEMINI_API_KEY=
