# Neon Postgres connection string (Project -> Connection Details in the Neon console)
DATABASE_URL=

JWT_SECRET=

# Comma-separated list of extra allowed frontend origins (localhost:5173
# and the production Vercel frontend are always allowed).
CLIENT_ORIGIN=

# Gmail OAuth ("Web application" client type). GMAIL_REDIRECT_URI must point
# at this server's own /auth/gmail/callback route and be registered as an
# Authorized redirect URI on that client in Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://job-tracker-psi-ten.vercel.app/auth/gmail/callback

# Encrypts Gmail refresh tokens at rest in the gmail_connections table.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Different from JWT_SECRET on purpose — a leaked JWT secret and a leaked
# token-encryption key are different blast radii.
TOKEN_ENCRYPTION_KEY=

# Which provider classifies stages: "groq" or "gemini". If unset, whichever
# key is present wins (Gemini first). Set it explicitly in any deployment --
# an unset value plus a key with no billing means every call fails into the
# weaker rules path, which the sync summary reports as llmFailed.
LLM_PROVIDER=groq

# Groq powers the primary stage/title classifier (free tier is enough).
# Without a key the deterministic rules still run, but stage accuracy drops
# noticeably -- the sync summary reports llmFailed so this is visible.
GROQ_API_KEY=

# Optional. Overrides the pinned model; see server/sync/llm.js. Re-run
# `node scripts/score-llm.js` after changing it to see what accuracy did.
GROQ_MODEL=

# Only needed for the one-time `npm run get-token` script — the job-tracker
# login a Gmail connection should be attached to. The app's own /connect
# flow doesn't use this.
TARGET_USER_EMAIL=

# Forwarding ingestion (server/routes/inboundRouter.js) -- the free
# alternative to Gmail OAuth. MAILGUN_DOMAIN is the sandbox (or real) domain
# from the Mailgun dashboard that inbound routes deliver to; aliases are
# generated as job-<userId>-<token>@MAILGUN_DOMAIN. MAILGUN_SIGNING_KEY is
# the account's HTTP webhook signing key (Mailgun dashboard -> Sending ->
# Webhooks -> Signing key) -- without it every webhook delivery is rejected,
# rather than accepted unverified.
MAILGUN_DOMAIN=
MAILGUN_SIGNING_KEY=
