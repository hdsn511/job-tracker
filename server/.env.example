# Neon Postgres connection string (Project -> Connection Details in the Neon console)
DATABASE_URL=

JWT_SECRET=

# Comma-separated list of extra allowed frontend origins (localhost:5173
# and the production Vercel frontend are always allowed).
CLIENT_ORIGIN=

# Gmail OAuth ("Web application" client type) — same client email-sync's
# local get-token setup uses, but this needs GMAIL_REDIRECT_URI pointed at
# this server's own /auth/gmail/callback route, registered as an
# Authorized redirect URI on that client in Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://job-tracker-psi-ten.vercel.app/auth/gmail/callback

# Must be the exact same value as email-sync's TOKEN_ENCRYPTION_KEY — both
# read/write the same gmail_connections table.
TOKEN_ENCRYPTION_KEY=
